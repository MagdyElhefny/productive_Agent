# ── LLM ──────────────────────────────────────────────────────────────────────
# OpenRouter API key (required)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use (optional — defaults to openai/gpt-5-nano)
AGENT_MODEL=openai/gpt-5-nano

# ── Web Search ────────────────────────────────────────────────────────────────
# Tavily API key for web search (required for web search feature)
TAVILY_API_KEY=your_tavily_api_key_here

# ── Agent-specific models (optional overrides) ────────────────────────────────
EMAIL_AGENT_MODEL=
TASK_AGENT_MODEL=
INTERVIEW_AGENT_MODEL=

# ── User ──────────────────────────────────────────────────────────────────────
TASK_AGENT_USER=local-user

# ── Data paths (optional — defaults point to data/ and credentials/) ──────────
TASK_DB_PATH=data/tasks.db
MEMORY_DB_PATH=data/memory.db
USER_PREFS_PATH=data/user_preferences.json

# ── CV path (optional — relative to project root or absolute) ─────────────────
# Place your CV PDF in agent/ or provide an absolute path
INTERVIEW_CV_PATH=agent/Magdy_Mohamed_cv_ai.pdf
